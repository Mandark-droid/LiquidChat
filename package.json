{
  "name": "LiquidChat",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src __tests__ --max-warnings=200",
    "lint:fix": "eslint src __tests__ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.36.1",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@opentelemetry/api": "1.9.1",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@traceverse/genai-otel-instrument-node": "0.1.0-alpha.9",
    "cactus-react-native": "^1.13.1",
    "jszip": "^3.10.2",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-device-info": "^15.0.1",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-image-picker": "^8.2.1",
    "react-native-nitro-modules": "^0.33.9",
    "react-native-permissions": "^5.4.4",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-torch": "^1.2.0",
    "react-native-tts": "^4.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "^9.39.5",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/metro-config": "0.81.1",
    "@react-native/typescript-config": "0.81.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "babel-jest": "^29.7.0",
    "better-sqlite3": "^11.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "react-native-builder-bob": "^0.40.14",
    "react-native-monorepo-config": "^0.1.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=20"
  },
  "op-sqlite": {
    "sqlcipher": true,
    "fts5": true
  }
}
